{
	"schemaVersion": 1,
	"id": "securitycraft",
	"version": "${version}",
	"name": "SecurityCraft",
	"accessWidener": "securitycraft.accesswidener",
	"description": "Adds a load of things to keep your house safe with and defend yourself from attackers. Fabric port by Verkos, based on the original NeoForge/Forge mod by the SecurityCraft team.",
	"authors": [
		"Verkos"
	],
	"contributors": [
		"Geforce",
		"bl4ckscor3",
		"Redstone_Dubstep",
		"ChainmailPickaxe"
	],
	"contact": {
		"homepage": "https://github.com/VerkoSK/SecurityCraftFabric",
		"sources": "https://github.com/VerkoSK/SecurityCraftFabric",
		"issues": "https://github.com/VerkoSK/SecurityCraftFabric/issues"
	},
	"license": "MIT",
	"icon": "sc_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.geforcemods.securitycraft.SecurityCraft"
		],
		"client": [
			"net.geforcemods.securitycraft.SecurityCraftClient"
		],
		"jei_mod_plugin": [
			"net.geforcemods.securitycraft.compat.jei.SCJEIPlugin"
		],
		"jade": [
			"net.geforcemods.securitycraft.compat.jade.SCJadePlugin"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"minecraft": "~1.20.1",
		"java": ">=17"
	},
	"suggests": {
		"jei": "*",
		"jade": "*"
	}
}
