	"authors": [
		"Geforce",
		"bl4ckscor3",
		"Redstone_Dubstep",
		"ChainmailPickaxe"
	],
	"contributors": [
		"Fabric port maintainer"
	],
	"contact": {
		"homepage": "https://github.com/VerkoSK/SecurityCraftFabric",
		"sources": "https://github.com/VerkoSK/SecurityCraftFabric",
		"issues": "https://github.com/VerkoSK/SecurityCraftFabric/issues"
	},
	"license": "MIT",
	"icon": "sc_logo.png",
