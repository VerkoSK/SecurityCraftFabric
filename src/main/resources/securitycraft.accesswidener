accessWidener	v2	named

# CheckPasscodeScreen's CensoringEditBox swaps EditBox's backing string around super calls to render asterisks.
accessible	field	net/minecraft/client/gui/components/EditBox	value	Ljava/lang/String;

# BaseFullMineBlock#wasExploded compares its position against the explosion's center. Forge patches in
# Explosion#getPosition(), vanilla keeps x/y/z private.
accessible	field	net/minecraft/world/level/Explosion	x	D
accessible	field	net/minecraft/world/level/Explosion	y	D
accessible	field	net/minecraft/world/level/Explosion	z	D

# BrushableMineBlockEntity re-implements BrushableBlockEntity#brush/#checkReset on top of vanilla's private brushing
# state. Upstream gets the same access from Forge's access transformers.
# Do NOT widen BrushableBlockEntity#brushingCompleted: `accessible` makes a private method final, which would clash
# with BrushableMineBlockEntity's own same-named method.
accessible	field	net/minecraft/world/level/block/entity/BrushableBlockEntity	brushCount	I
accessible	field	net/minecraft/world/level/block/entity/BrushableBlockEntity	brushCountResetsAtTick	J
accessible	field	net/minecraft/world/level/block/entity/BrushableBlockEntity	coolDownEndsAtTick	J
accessible	field	net/minecraft/world/level/block/entity/BrushableBlockEntity	hitDirection	Lnet/minecraft/core/Direction;
accessible	method	net/minecraft/world/level/block/entity/BrushableBlockEntity	dropContent	(Lnet/minecraft/world/entity/player/Player;)V
accessible	method	net/minecraft/world/level/block/entity/BrushableBlockEntity	getCompletionState	()I

# OwnableBlock registers reinforced blocks as unbreakable and hands the real destroy time back only to the
# owner, which means reading the destroy time the block asked for. Upstream gets this from a Forge AT.
accessible	field	net/minecraft/world/level/block/state/BlockBehaviour$Properties	destroyTime	F

# KeypadChestBlock only lets a chest pair up with another chest of the same owner, which means calling vanilla's
# own partner-facing check first. KeypadChestBlockEntity drives the lid animation and the open/close sounds
# through the same counter the vanilla chest uses. Upstream gets both from Forge's access transformers.
extendable	method	net/minecraft/world/level/block/ChestBlock	candidatePartnerFacing	(Lnet/minecraft/world/item/context/BlockPlaceContext;Lnet/minecraft/core/Direction;)Lnet/minecraft/core/Direction;
accessible	field	net/minecraft/world/level/block/entity/ChestBlockEntity	openersCounter	Lnet/minecraft/world/level/block/entity/ContainerOpenersCounter;

# SCManualScreen draws its widgets itself, in between the page background and the page text, instead of letting
# Screen#render do it at the end. Upstream reaches the same list through Forge's access transformers.
accessible	field	net/minecraft/client/gui/screens/Screen	renderables	Ljava/util/List;

# The reinforced pistons, lectern and its block entity re-use vanilla's own logic, which keeps several members
# private; isFittingBase and openScreen have to be extendable rather than accessible, because vanilla calls them
# on this and the JVM only dispatches virtually once the private flag is gone.
accessible	field	net/minecraft/world/level/block/piston/PistonBaseBlock	isSticky	Z
extendable	method	net/minecraft/world/level/block/piston/PistonHeadBlock	isFittingBase	(Lnet/minecraft/world/level/block/state/BlockState;Lnet/minecraft/world/level/block/state/BlockState;)Z
extendable	method	net/minecraft/world/level/block/LecternBlock	openScreen	(Lnet/minecraft/world/level/Level;Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/entity/player/Player;)V
accessible	field	net/minecraft/world/level/block/entity/LecternBlockEntity	bookAccess	Lnet/minecraft/world/Container;
accessible	field	net/minecraft/world/level/block/entity/LecternBlockEntity	dataAccess	Lnet/minecraft/world/inventory/ContainerData;

# ReinforcedLecternScreen hides the page buttons from anyone who may not turn the page. Vanilla keeps the two
# buttons and the method that shows them private; upstream reaches them through Forge's access transformers.
accessible	field	net/minecraft/client/gui/screens/inventory/BookViewScreen	forwardButton	Lnet/minecraft/client/gui/screens/inventory/PageButton;
accessible	field	net/minecraft/client/gui/screens/inventory/BookViewScreen	backButton	Lnet/minecraft/client/gui/screens/inventory/PageButton;
extendable	method	net/minecraft/client/gui/screens/inventory/BookViewScreen	updateButtonVisibility	()V

# The original's always_drop config defaults to true, which it honours by overriding Forge's canHarvestBlock.
# Fabric has no such hook, so the flag has to be cleared on the properties instead, and vanilla only offers a
# setter that turns it on.
accessible	field	net/minecraft/world/level/block/state/BlockBehaviour$Properties	requiresCorrectToolForDrops	Z

# The secret signs draw their text only for the players allowed to read it, which means overriding the one method
# vanilla's sign renderer routes everything through, and calling the three helpers it uses. All four are
# package-private; upstream reaches them through Forge's access transformers.
extendable	method	net/minecraft/client/renderer/blockentity/SignRenderer	renderSignWithText	(Lnet/minecraft/world/level/block/entity/SignBlockEntity;Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/MultiBufferSource;IILnet/minecraft/world/level/block/state/BlockState;Lnet/minecraft/world/level/block/SignBlock;Lnet/minecraft/world/level/block/state/properties/WoodType;Lnet/minecraft/client/model/Model;)V
accessible	method	net/minecraft/client/renderer/blockentity/SignRenderer	translateSign	(Lcom/mojang/blaze3d/vertex/PoseStack;FLnet/minecraft/world/level/block/state/BlockState;)V
accessible	method	net/minecraft/client/renderer/blockentity/SignRenderer	renderSign	(Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/MultiBufferSource;IILnet/minecraft/world/level/block/state/properties/WoodType;Lnet/minecraft/client/model/Model;)V
accessible	method	net/minecraft/client/renderer/blockentity/SignRenderer	renderSignText	(Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/level/block/entity/SignText;Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/MultiBufferSource;IIIZ)V
accessible	method	net/minecraft/client/renderer/blockentity/HangingSignRenderer	translateSign	(Lcom/mojang/blaze3d/vertex/PoseStack;FLnet/minecraft/world/level/block/state/BlockState;)V
